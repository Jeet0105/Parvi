PORT=5000
NODE_ENV=development

# PostgreSQL connection (no real credentials in this file)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/family_identity?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/family_identity_test?schema=public"

JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="1d"

UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

CORS_ORIGIN="http://localhost:5173"

# Optional, only used once Redis is introduced
REDIS_URL="redis://localhost:6379"

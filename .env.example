# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/family_identity?schema=public

# Redis (Optional, automatic memory fallback if unavailable)
REDIS_URL=redis://localhost:6379
ENABLE_REDIS=true

# Authentication (JWT)
JWT_SECRET=development-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Seed Settings
SEED_PASSWORD=Password123
